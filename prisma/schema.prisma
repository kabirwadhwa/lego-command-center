datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  FAMILY_SELLER
  VIEWER
}

enum InventoryAccountType {
  COMPANY
  PERSONAL
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  TRANSFER
  MANUAL_ADJUSTMENT
  RETURN
  DAMAGED
  STOCK_COUNT_CORRECTION
  IMPORT
}

enum MarketplaceType {
  SHOPIFY
  BOL
  CATAWIKI
  BRICKLINK
  EBAY
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  DRAFT
  SOLD_OUT
}

enum PriceType {
  ASKING_PRICE
  BUY_NOW
  CURRENT_BID
  SOLD_PRICE
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum PurchaseStatus {
  RECEIVED
  PENDING
  CANCELLED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  SYNC_ERROR
  UNMATCHED_ORDER
  PRICE_OPPORTUNITY
  UNPROFITABLE_PRICE
  STALE_DATA
  MISSING_SKU
}

enum EventStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ProductCondition {
  NEW_SEALED
  USED_COMPLETE
  DAMAGED_BOX
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum ActorType {
  USER
  SYSTEM
  MARKETPLACE
}

// ==========================================
// MODELS
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  status    String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Conceptual LEGO Set
model Product {
  id        String   @id @default(uuid())
  setNumber String   @unique // e.g. "10316"
  name      String
  theme     String
  imageUrl  String?
  ean       String?  // Optional global barcode
  status    String   @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants  ProductVariant[]
  snapshots MarketPriceSnapshot[]
}

// Specific physical variation of a LEGO set (condition, internal SKU)
model ProductVariant {
  id              String           @id @default(uuid())
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku             String           @unique
  condition       ProductCondition @default(NEW_SEALED)
  storageLocation String?
  notes           String?
  status          VariantStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  balances        InventoryBalance[]
  transactions    InventoryTransaction[]
  listings        MarketplaceListing[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  recommendations PriceRecommendation[]
  alerts          Alert[]
  syncJobs        SyncJob[]
}

// Relational Account Entity (Vervliet Enterprises or Stock X)
model InventoryAccount {
  id           String               @id @default(uuid())
  name         String               @unique
  type         InventoryAccountType
  status       String               @default("ACTIVE")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  balances     InventoryBalance[]
  transactions InventoryTransaction[]
  saleItems    SaleItem[]
  purchaseItems PurchaseItem[]
}

// Derived stock balances updated via atomic ledger transactions
model InventoryBalance {
  id                 String           @id @default(uuid())
  productVariantId   String
  productVariant     ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryAccountId String
  inventoryAccount   InventoryAccount @relation(fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  quantity           Int              @default(0)
  averageCost        Decimal          @db.Decimal(12, 2) @default(0.00)
  lastUpdated        DateTime         @default(now())

  @@unique([productVariantId, inventoryAccountId])
}

// Immutable ledger recording every quantity change
model InventoryTransaction {
  id                  String                   @id @default(uuid())
  productVariantId    String
  productVariant      ProductVariant           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryAccountId  String
  inventoryAccount    InventoryAccount         @relation(fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  type                InventoryTransactionType
  quantity            Int                      // Positive = add, Negative = deduct
  unitCost            Decimal?                 @db.Decimal(12, 2)
  channel             MarketplaceType?
  externalOrderId     String?
  linkedTransactionId String?                  // References associated transfer leg
  actorType           ActorType                @default(USER)
  actorId             String                   // User UUID, "SYSTEM", or Marketplace identifier
  actorName           String                   // Text cache to preserve name if user deactivated
  notes               String?
  createdAt           DateTime                 @default(now())
}

// Commercial Sales Records
model Sale {
  id              String           @id @default(uuid())
  marketplaceId   MarketplaceType? // Null for offline/manual sales
  externalOrderId String?
  saleDate        DateTime         @default(now())
  status          SaleStatus       @default(COMPLETED)
  currency        String           @default("EUR")
  grossRevenue    Decimal          @db.Decimal(12, 2)
  marketplaceFees Decimal          @db.Decimal(12, 2) @default(0.00)
  shippingRevenue Decimal          @db.Decimal(12, 2) @default(0.00)
  shippingCost    Decimal          @db.Decimal(12, 2) @default(0.00)
  discount        Decimal          @db.Decimal(12, 2) @default(0.00)
  netRevenue      Decimal          @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           SaleItem[]

  @@unique([marketplaceId, externalOrderId]) // Order-level idempotency
}

model SaleItem {
  id                 String           @id @default(uuid())
  saleId             String
  sale               Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productVariantId   String
  productVariant     ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryAccountId String
  inventoryAccount   InventoryAccount @relation(fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  quantity           Int
  unitSalePrice      Decimal          @db.Decimal(12, 2)
  unitCostAtSale     Decimal          @db.Decimal(12, 2)
  lineRevenue        Decimal          @db.Decimal(12, 2)
}

// Commercial Purchase Records
model Purchase {
  id           String         @id @default(uuid())
  supplier     String
  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(RECEIVED)
  currency     String         @default("EUR")
  totalCost    Decimal        @db.Decimal(12, 2)
  shippingCost Decimal        @db.Decimal(12, 2) @default(0.00)
  importFees   Decimal        @db.Decimal(12, 2) @default(0.00)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items        PurchaseItem[]
}

model PurchaseItem {
  id                 String           @id @default(uuid())
  purchaseId         String
  purchase           Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  productVariantId   String
  productVariant     ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryAccountId String
  inventoryAccount   InventoryAccount @relation(fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  quantity           Int
  unitCost           Decimal          @db.Decimal(12, 2)
}

// Generic Webhook & Marketplace Incoming Event Store (Idempotency)
model MarketplaceEvent {
  id              String          @id @default(uuid())
  marketplaceId   MarketplaceType
  externalEventId String          // Webhook ID
  eventType       String          // e.g. "orders/create"
  externalOrderId String?
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  processingStatus EventStatus    @default(PENDING)
  failureReason   String?
  payload         String?

  @@unique([marketplaceId, externalEventId]) // Event-level idempotency
}

// Marketplace Configuration & Capabilities Config
model Marketplace {
  id                    MarketplaceType @id
  name                  String
  status                String          // "CONNECTED", "DISCONNECTED"
  mode                  String          // "REAL", "DEMO"
  credentialsJson       String?         // Encrypted config JSON
  supportsOrders        Boolean         @default(true)
  supportsInventorySync Boolean         @default(true)
  supportsPriceFeed     Boolean         @default(false)
  supportsAuctions      Boolean         @default(false)
  supportsWebhooks      Boolean         @default(false)
  lastSyncedAt          DateTime?
}

// Active Listings associated with variants
model MarketplaceListing {
  id                 String          @id @default(uuid())
  productVariantId   String
  productVariant     ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  marketplace        MarketplaceType
  externalListingId  String
  listingUrl         String?
  status             ListingStatus   @default(ACTIVE)
  price              Decimal         @db.Decimal(12, 2)
  quantity           Int
  lastSyncedAt       DateTime        @default(now())

  // Catawiki-specific auction fields
  catawikiCurrentBid Decimal?        @db.Decimal(12, 2)
  catawikiReserve    Decimal?        @db.Decimal(12, 2)
  catawikiBuyNow     Decimal?        @db.Decimal(12, 2)
  catawikiAuctionEnd DateTime?

  @@unique([marketplace, externalListingId])
}

// Historical and current price observations
model MarketPriceSnapshot {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  marketplace       String    // Competitor name or site URL
  price             Decimal   @db.Decimal(12, 2)
  priceType         PriceType
  currency          String    @default("EUR")
  shipping          Decimal?  @db.Decimal(12, 2)
  condition         String?
  seller            String?
  capturedAt        DateTime  @default(now())
  externalListingId String?
  externalUrl       String?
  auctionEndAt      DateTime?
  availability      Boolean   @default(true)
}

// Suggested pricing modifications
model PriceRecommendation {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  recommendedPrice Decimal        @db.Decimal(12, 2)
  reasoning        String
  updatedAt        DateTime       @default(now())
}

// Job Runner tracking
model SyncJob {
  id               String          @id @default(uuid())
  marketplace      MarketplaceType
  operation        String
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  status           SyncStatus      @default(PENDING)
  attemptNumber    Int             @default(1)
  createdAt        DateTime        @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  errorDetails     String?
}

// Real-time notifications
model Alert {
  id               String          @id @default(uuid())
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  type             AlertType
  severity         AlertSeverity
  message          String
  resolved         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  resolvedAt       DateTime?
}

// System logging logs
model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType @default(USER)
  actorId    String    // User ID or SYSTEM/MARKETPLACE identifier
  actorName  String
  action     String
  details    String?
  createdAt  DateTime  @default(now())
}
