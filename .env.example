# Database Connections
DATABASE_URL="postgresql://user:password@localhost:5432/lego_command_center?schema=public"
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/lego_command_center_test?schema=public"

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Integrations Configuration
# Mode: "DEMO" (default for offline testing) or "REAL" (requires credentials)
NEXT_PUBLIC_INTEGRATION_MODE="DEMO"

# Shopify Connection
SHOPIFY_STORE_URL="https://your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_your_access_token"

# Bol.com Connection
BOL_CLIENT_ID="your-bol-client-id"
BOL_CLIENT_SECRET="your-bol-client-secret"

# Catawiki Connection
CATAWIKI_CLIENT_ID="your-catawiki-client-id"
CATAWIKI_CLIENT_SECRET="your-catawiki-client-secret"

# Local Secrets
JWT_SECRET="your-local-jwt-secret-at-least-32-chars-long"
