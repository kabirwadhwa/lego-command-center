# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lego_command_center"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/lego_command_center_test"

# Application Mode
# "true" enables simulated demo login and sandbox mode; "false" enforces strict Supabase SSR auth
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_INTEGRATION_MODE="DEMO"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication (Required in Production)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Secret for Demo Mode Authentication and NextAuth/Session signing
NEXTAUTH_SECRET="random-secure-secret-minimum-32-chars-long"

# Shopify Marketplace Integration (REAL mode)
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_STORE_URL="https://your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_your_admin_access_token"
SHOPIFY_ACCESS_TOKEN="shpat_your_admin_access_token"
SHOPIFY_WEBHOOK_SECRET="your_webhook_signing_secret"

# Apify Scraper Integration (Catawiki & Competitors)
APIFY_API_TOKEN="apify_api_your_token"
APIFY_ACTOR_ID="your-actor-id"

# Bol.com Plaza Connection (Roadmap)
BOL_CLIENT_ID="your-bol-client-id"
BOL_CLIENT_SECRET="your-bol-client-secret"

# Catawiki Connection (Roadmap)
CATAWIKI_CLIENT_ID="your-catawiki-client-id"
CATAWIKI_CLIENT_SECRET="your-catawiki-client-secret"

# Optional Test/Debug Route Gate (Blocked by default in production)
ENABLE_TEST_ROUTES="false"
TEST_ROUTE_SECRET=""
